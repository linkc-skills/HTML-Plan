  "plan": {
    "goal": "做一个让用户能 10 分钟整理一次「灵感采访」的轻量工具",
    "context": "用户每天和 ChatGPT / Gemini 做大量「被采访」式思考复盘，但散落各处。需要一个把这些对话沉淀到个人知识库的工作面。",
    "key_points": [
      "本地优先，不依赖任何云服务",
      "和个人 wiki / journal 编译流程对接",
      "支持语音输入起步"
    ],
    "steps": [
      { "id": "s1", "title": "把 PRD 和用户故事写清楚", "status": "in_progress", "notes": "正在用 html-plan 自己做这件事。", "diagram": "" },
      { "id": "s2", "title": "做一个 CLI 原型", "status": "todo", "notes": "MVP 不要 UI。" },
      { "id": "s3", "title": "和现有 ingest 链路对接", "status": "todo", "notes": "" }
    ]
  },

  "prd": {
    "problem": "我每天在 ChatGPT / Gemini 里做大量「被采访」式的思考复盘，但这些对话沉淀不下来——既不会自动进个人知识库，也很难在未来检索。",
    "audience": "用户（重度自我对话用户）+ 未来可能扩展到所有内容创作者",
    "goals": [
      "10 分钟以内能完成一次「灵感采访」的录制和归档",
      "采访内容自动进入个人知识库的 ingest 流",
      "结构化输出：主题、关键观点、未解问题"
    ],
    "non_goals": [
      "不做团队协作 / 分享功能（个人工具）",
      "不做语音转写的自研模型（用现成 API）",
      "不做 UI 美化 / 主题切换（MVP 命令行就够了）"
    ],
    "scope": "MVP 包含：录音 → 转写 → 让 LLM 当采访人 → 结构化输出 → 落到 ./inbox/。不含：批量历史导入、跨设备同步、多人共享。",
    "success_metrics": [
      { "metric": "每周采访次数", "baseline": "0", "target": "≥ 5 次" },
      { "metric": "采访 → 归档完成时间", "baseline": "目前 ~30 分钟", "target": "≤ 10 分钟" },
      { "metric": "归档信息被引用率（30 天内）", "baseline": "—", "target": "≥ 40%" }
    ],
    "constraints": [
      "本地优先，无云依赖",
      "复用现有 skill 体系",
      "MVP 必须能在 1 周内做出来"
    ],
    "timeline": "Week 1: CLI 原型 + 转写跑通  ·  Week 2: 与个人知识库对接  ·  Week 3: 试用 + 迭代"
  },

